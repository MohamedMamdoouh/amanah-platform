# Naming reference only, these are placeholders.

# ConnectionStrings__Default — local dev: direct (db.<ref>.supabase.co, user postgres)
# ConnectionStrings__Default — Render: Session pooler (aws-0-<region>.pooler.supabase.com, user postgres.<ref>)
# Jwt__AccessTokenSigningKey=            # min 32 chars
# Jwt__HandoffTokenSigningKey=           # min 32 chars
# Turnstile__SecretKey=
# Turnstile site key: web/src/environments/environment.production.ts (public; commit with deploy)
# ADMIN_PHONE=+20...
# ADMIN_PASSWORD=                       # min 8 chars
# USER1_PHONE=+20...                    # optional — bootstrap user
# USER2_PHONE=+20...                    # optional — second bootstrap user
# USER_PASSWORD=                        # optional — shared password for both users, min 8 chars
# Cors__AllowedOrigins__0=https://<your-service>.onrender.com
# Bucket__Endpoint=https://<account-id>.r2.cloudflarestorage.com
# Bucket__AccessKey=
# Bucket__SecretKey=
# Bucket__Name=amanah-media
# Bucket__PublicBaseUrl=https://pub-<id>.r2.dev   # optional; public/custom domain for <img> thumbnails
# Sms__ApiKey=                           # Unimtx AccessKey ID (Console → Credentials)
# Email__ApiKey=                         # Brevo API key (xkeysib-...) — optional locally
# Email__FromAddress=                    # Verified sender email, e.g. alerts@yourdomain.com
# Email__FromName=Amanah                 # Required by Brevo
# Email__AdminAlertTo=                   # Admin inbox for moderation-queue alerts
# Email__AppBaseUrl=                     # Optional; defaults to first Cors origin
# Email__OutboxPollIntervalSeconds=30    # Background worker poll interval
# Email__OutboxMaxAttempts=5
# Email__OutboxBatchSize=10
