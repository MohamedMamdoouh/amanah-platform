{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cache": {
    "CategoriesTtlSeconds": 3600,
    "GovernoratesTtlSeconds": 86400
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimit": {
    "Policies": {
      "otp-send": {
        "PermitLimit": 10,
        "WindowSeconds": 3600
      }
    }
  },
  "HttpTimeouts": {
    "IncomingRequestSeconds": 30,
    "OutgoingHttpSeconds": 10
  },
  "ForwardedHeaders": {
    "KnownNetworks": [
      "100.0.0.0/8"
    ]
  }
}
